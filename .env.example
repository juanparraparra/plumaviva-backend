# Copia este archivo como .env y ajusta los valores
PORT=3000

# Capa 3 · MySQL/MariaDB de XAMPP (por defecto: root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plumaviva

# Cambia este valor por una cadena larga y aleatoria (en producción es obligatorio)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES=8h

# Orígenes permitidos por CORS, separados por coma (solo hace falta si el front se sirve desde otro dominio)
CORS_ORIGINS=http://localhost:3000

# (opcional) máximo de intentos de ingreso por equipo cada 15 min; súbelo solo si haces muchas pruebas seguidas
# LIMITE_LOGIN_IP=30

# Correo transaccional. En desarrollo puede usar MAIL_DRIVER=console; en producción exige smtp.
# Brevo: MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_SECURE=false
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true (use una contraseña de aplicación)
MAIL_DRIVER=console
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="PlumaViva <no-reply@tudominio.com>"
APP_URL=http://localhost:3000
# Archivo opcional donde el modo consola guarda los correos para las pruebas
# MAIL_OUTBOX=.correos-dev.jsonl

# (opcional) Secreto para firmar los códigos 2FA. Si no se define se usa JWT_SECRET.
# OTP_SECRET=
# (opcional) Si está detrás de un proxy inverso: TRUST_PROXY=1
